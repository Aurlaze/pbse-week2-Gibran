{
  "name": "spec",
  "version": "0.1.0",
  "private": true,
  "description": "The written interface, and a mock server built from it. No service code lives here.",
  "scripts": {
    "lint": "redocly lint ../openapi.yaml",
    "docs": "redocly build-docs ../openapi.yaml -o docs.html",
    "mock": "prism mock ../openapi.yaml",
    "mock:dynamic": "prism mock -d ../openapi.yaml",
    "check": "npm run lint && npm run docs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "@stoplight/prism-cli": "5.15.11"
  }
}
