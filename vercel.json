{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "framework": "vite"
    },
    "api": {
      "root": "service/",
      "framework": "express",
      "entrypoint": "api/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
