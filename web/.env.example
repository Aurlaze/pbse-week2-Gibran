# Copy to .env.local and fill in. Vite only exposes variables prefixed
# VITE_ to the browser — and everything it exposes is readable by anyone
# who opens the page, so no secret belongs in this file.

# The service from Session 3/4. No trailing slash; the path carries /v1.
VITE_API_BASE_URL=http://localhost:3000/v1

# Keycloak, from Session 4.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=badminton-booking
VITE_KEYCLOAK_CLIENT_ID=badminton-student-web

# Space-separated optional scopes to request at sign-in. Scopes listed as
# optional on the client are absent from the token unless asked for.
#
# courts:write is requested by everybody and granted to nobody who lacks
# the administrator role: the realm limits that scope to that role. A
# student signing in simply does not receive it, and the court-management
# link is not rendered for them. That hiding is cosmetic — the service
# refuses the operation regardless (A.9).
VITE_KEYCLOAK_SCOPES=bookings:write courts:write
